{
  "name": "baology",
  "version": "0.0.0",
  "private": true,
  "description": "Baology Prep static site",
  "scripts": {
    "build": "node scripts/build.js",
    "check:generated": "node scripts/check-generated.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:scanners": "node scripts/css-source.js",
    "check:colors": "node scripts/color-guard.js",
    "check:spacing": "node scripts/spacing-guard.js",
    "check:radius": "node scripts/radius-guard.js",
    "check:type": "node scripts/type-guard.js",
    "list:generated": "node scripts/build.js --list-generated"
  },
  "devDependencies": {
    "image-size": "^2.0.2",
    "js-yaml": "^4.1.0"
  }
}
